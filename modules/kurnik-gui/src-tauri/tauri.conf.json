{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kurnik GUI",
  "version": "0.1.0",
  "identifier": "pl.kurnik.gui",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd ../ui && npm run dev",
    "beforeBuildCommand": "cd ../ui && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kurnik GUI",
        "width": 1000,
        "height": 680,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "shell": { "open": true }
  }
}
